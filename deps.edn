{:aliases
 {;; nREPL server
  :serve
  {:replace-paths []
   :replace-deps {clojure-cli.repl/server {:local/root "server"}}
   :main-opts ["-m" "clojure-cli.repl.server"]}

  ;; terminal client
  :attach
  {:replace-paths []
   :replace-deps {clojure-cli.repl/client {:local/root "client"}}
   :main-opts ["-m" "clojure-cli.repl.client"]}}}
