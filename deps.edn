{:paths ["src"]
 :deps {org.clojure/clojure            {:mvn/version "1.12.5"}
        org.clojure/tools.reader       {:mvn/version "1.6.0"}
        org.jline/jline                {:mvn/version "4.1.2"}
        org.clojure/tools.deps.config  {:local/root "../tools.deps.config"}} ;; TODO

 :aliases {:repl {:main-opts ["-m" "clj-line.main"]}
           :dev {:extra-deps {nrepl/nrepl {:mvn/version "1.1.2"}
                              cider/cider-nrepl {:mvn/version "0.49.0"}}
                 :main-opts ["-m" "nrepl.cmdline"
                             "--middleware" "[cider.nrepl/cider-middleware]"
                             "--interactive"]}
           :test {:extra-paths ["test"]
                  :extra-deps {io.github.cognitect-labs/test-runner
                               {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                  :main-opts ["-m" "cognitect.test-runner"]
                  :exec-fn cognitect.test-runner.api/test}}}
